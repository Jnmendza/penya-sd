generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id                String   @id @default(uuid()) // References auth.users via code logic
  email             String   @unique
  firstName         String?  @map("first_name")
  lastName          String?  @map("last_name")
  phone             String?
  role              Role     @default(MEMBER)
  status            Status   @default(PENDING)
  membershipEndDate DateTime? @map("membership_end_date") @db.Timestamptz
  stripeCustomerId  String?  @map("stripe_customer_id")
  confederationId   String?  @map("confederation_id")
  
  // Storing the simple JSON object for merch status
  merchStatus       Json?    @default("{\"scarf\": false, \"pin\": false}") @map("merch_status")

  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("profiles")
}

model Event {
  id             String   @id @default(uuid())
  apiMatchId     String   @unique @map("api_match_id")
  homeTeam       String   @map("home_team")
  awayTeam       String   @map("away_team")
  kickoffTime    DateTime @map("kickoff_time") @db.Timestamptz
  competition    String?
  venue          String   @default("Novo Brewery")
  isWatchParty   Boolean  @default(false) @map("is_watch_party")
  broadcastInfo  String?  @map("broadcast_info")
  
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("events")
}

model MemberApplication {
  id            String        @id @default(uuid())
  firstName     String        @map("first_name")
  lastName      String        @map("last_name")
  email         String
  phone         String?
  isReturning   Boolean       @default(false) @map("is_returning")
  paymentMethod String        @map("payment_method") // "venmo" | "cashapp" | "cash"
  paymentHandle String?       @map("payment_handle")
  status        String        @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  season        String
  children      ChildMember[]
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@map("member_applications")
}

model ChildMember {
  id                  String            @id @default(uuid())
  name                String
  age                 Int
  parentApplicationId String            @map("parent_application_id")
  application         MemberApplication @relation(fields: [parentApplicationId], references: [id], onDelete: Cascade)

  @@map("child_members")
}

enum Role {
  MEMBER
  ADMIN
  BOARD
}

enum Status {
  ACTIVE
  EXPIRED
  PENDING
}